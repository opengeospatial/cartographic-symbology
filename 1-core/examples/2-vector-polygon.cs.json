{
  "metadata": {
    "title": "Styling polygon vector features",
    "description": "Basic vector features styling (polygons): land cover in Rondane, Norway (N50 Kartdata)"
  },
  "stylingRules": [
    {
      "selector": {
        "op": "and",
        "args": [
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.id"
              },
              "Landcover"
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "=",
                "args": [
                  {
                    "sysId": "dataLayer.type"
                  },
                  "vector"
                ]
              },
              {
                "op": "=",
                "args": [
                  {
                    "sysId": "dataLayer.featuresGeometryDimensions"
                  },
                  2
                ]
              }
            ]
          }
        ]
      },
      "symbolizer": {
        "$comment": "Do not show Landcover layer by default\nNo default Dot at each polygon's centroid",
        "visibility": false,
        "marker": null
      },
      "nestedRules": [
        {
          "$comment": "Show land cover if zoomed in more than 1:200,000 for data valid within visualization's selected time range",
          "selector": {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "<",
                    "args": [
                      {
                        "sysId": "viz.sd"
                      },
                      200000
                    ]
                  },
                  {
                    "op": ">=",
                    "args": [
                      {
                        "property": "validDate"
                      },
                      {
                        "sysId": "viz.timeInterval.start.date"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "<=",
                "args": [
                  {
                    "property": "validDate"
                  },
                  {
                    "sysId": "viz.timeInterval.end.date"
                  }
                ]
              }
            ]
          },
          "symbolizer": {
            "$comment": "Open land and the other classes: a light neutral fill through which the relief below shows",
            "visibility": true,
            "opacity": 0.8,
            "zOrder": 1,
            "fill": {
              "color": [
                214,
                207,
                189
              ],
              "opacity": 0.5
            },
            "stroke": {
              "color": [
                168,
                160,
                140
              ],
              "opacity": 1.0,
              "width": {
                "px": 0.75
              }
            }
          },
          "nestedRules": [
            {
              "$comment": "Select different fill and stroke color based on class property",
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "bog"
                ]
              },
              "symbolizer": {
                "fill": {
                  "alter": true,
                  "color": [
                    203,
                    184,
                    103
                  ]
                },
                "stroke": {
                  "alter": true,
                  "color": [
                    143,
                    132,
                    72
                  ]
                }
              }
            },
            {
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "forest"
                ]
              },
              "symbolizer": {
                "fill": {
                  "alter": true,
                  "color": [
                    79,
                    138,
                    69
                  ]
                },
                "stroke": {
                  "alter": true,
                  "color": [
                    61,
                    107,
                    53
                  ]
                }
              }
            },
            {
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "lake"
                ]
              },
              "symbolizer": {
                "fill": {
                  "alter": true,
                  "color": [
                    111,
                    163,
                    204
                  ]
                },
                "stroke": {
                  "alter": true,
                  "color": [
                    47,
                    109,
                    158
                  ]
                }
              }
            },
            {
              "$comment": "If zoomed in more than 1:10,000",
              "selector": {
                "op": "<",
                "args": [
                  {
                    "sysId": "viz.sd"
                  },
                  10000
                ]
              },
              "symbolizer": {
                "$comment": "Change stroke width to 2 pixels\nAdd a text marker (positioned at centroid + horizontal offset) showing name property",
                "stroke": {
                  "alter": true,
                  "width": {
                    "px": 2.0
                  }
                },
                "marker": {
                  "elements": [
                    {
                      "type": "Text",
                      "position": {
                        "x": 20.0,
                        "y": 0.0
                      },
                      "text": {
                        "property": "name"
                      },
                      "alignment": [
                        "left",
                        "top"
                      ],
                      "font": {
                        "face": "Arial",
                        "size": 14,
                        "bold": false,
                        "italic": true,
                        "opacity": 1.0,
                        "color": [
                          31,
                          78,
                          121
                        ]
                      }
                    }
                  ]
                }
              },
              "nestedRules": [
                {
                  "$comment": "Add icons at centroid based on land cover class property",
                  "selector": {
                    "op": "=",
                    "args": [
                      {
                        "property": "class"
                      },
                      "bog"
                    ]
                  },
                  "symbolizer": {
                    "marker": {
                      "alter": true,
                      "elements": {
                        "index": 1,
                        "value": {
                          "type": "Image",
                          "image": {
                            "uri": "http://example.com/icons/bog.svg",
                            "path": "icons/bog.svg",
                            "id": "bog",
                            "type": "image/svg+xml",
                            "ext": "svg"
                          },
                          "hotSpot": [
                            {
                              "pc": 50
                            },
                            {
                              "pc": 50
                            }
                          ],
                          "tint": "white",
                          "blackTint": [
                            107,
                            95,
                            42
                          ],
                          "alphaThreshold": 0.1
                        }
                      }
                    }
                  }
                },
                {
                  "selector": {
                    "op": "=",
                    "args": [
                      {
                        "property": "class"
                      },
                      "forest"
                    ]
                  },
                  "symbolizer": {
                    "marker": {
                      "alter": true,
                      "elements": {
                        "index": 1,
                        "value": {
                          "type": "Image",
                          "image": {
                            "uri": "http://example.com/icons/forest.svg",
                            "path": "icons/forest.svg",
                            "id": "forest",
                            "type": "image/svg+xml",
                            "ext": "svg"
                          },
                          "hotSpot": [
                            {
                              "pc": 50
                            },
                            {
                              "pc": 50
                            }
                          ],
                          "tint": "white",
                          "blackTint": [
                            47,
                            93,
                            42
                          ],
                          "alphaThreshold": 0.1
                        }
                      }
                    }
                  }
                },
                {
                  "selector": {
                    "op": "=",
                    "args": [
                      {
                        "property": "class"
                      },
                      "lake"
                    ]
                  },
                  "symbolizer": {
                    "marker": {
                      "alter": true,
                      "elements": {
                        "index": 1,
                        "value": {
                          "type": "Image",
                          "image": {
                            "uri": "http://example.com/icons/lake.svg",
                            "path": "icons/lake.svg",
                            "id": "lake",
                            "type": "image/svg+xml",
                            "ext": "svg"
                          },
                          "hotSpot": [
                            {
                              "pc": 50
                            },
                            {
                              "pc": 50
                            }
                          ],
                          "tint": "white",
                          "blackTint": [
                            31,
                            78,
                            121
                          ],
                          "alphaThreshold": 0.1
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
