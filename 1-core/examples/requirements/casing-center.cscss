// /req/casing/center: center lines on top of the main strokes, not cut by joining roads
Roads
{
   marker: null;
   visibility: false;
   [class <> 'path' and class <> 'tractor']
   {
      visibility: true;
      stroke: { color: #f3e3b5; width: 5 px; casing: { color: #8c8172; width: 1 px }; center: { color: #d0483a; width: 1 px } };
   }
}
