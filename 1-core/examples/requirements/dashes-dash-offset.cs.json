{
  "stylingRules": [
    {
      "$comment": "/req/dashes/dash-offset: the dash pattern started at an offset at the beginning of each path",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Roads"
        ]
      },
      "symbolizer": {
        "visibility": false,
        "marker": null
      },
      "nestedRules": [
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "path"
            ]
          },
          "symbolizer": {
            "visibility": true,
            "stroke": {
              "color": [
                184,
                68,
                47
              ],
              "width": {
                "px": 2.5
              },
              "dashPattern": [
                {
                  "px": 10.0
                },
                {
                  "px": 10.0
                }
              ],
              "dashOffset": {
                "px": 5.0
              }
            }
          }
        }
      ]
    }
  ]
}
