// /req/vector/image: an Image marker on the cabins, 10 mm wide and high; the blue Dot marks the position of the Graphic
Huts
{
   marker: { elements: [
      Image {
         image: { uri: 'http://example.com/icons/hut.png'; path: '../icons/hut.png'; type: 'image/png' };
         hotSpot: 50 pc 100 pc; size: 10 mm; blackTint: #b8322a;
      },
      Dot { size: 5 px, color: #1f4e79 }
   ] };
}
