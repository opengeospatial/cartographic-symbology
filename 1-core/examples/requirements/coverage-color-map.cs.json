{
  "stylingRules": [
    {
      "$comment": "/req/coverage/color-map: the color of each cell mapped from its elevation",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Elevation"
        ]
      },
      "symbolizer": {
        "singleChannel": {
          "property": "elevation"
        },
        "colorMap": [
          [
            500.0,
            "#7d9a6a"
          ],
          [
            1300.0,
            "#d6c79e"
          ],
          [
            2100.0,
            "#9c8f84"
          ]
        ]
      }
    }
  ]
}
