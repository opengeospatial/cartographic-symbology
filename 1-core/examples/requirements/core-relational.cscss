// /req/core/relational: the peaks selected by comparing their elevation or their name
Places
{
   visibility: false;
   marker: null;
   [type = 'mountain']
   {
      visibility: true;
      marker: { elements: [ Dot { size: 4 px, color: #9a958b } ] };
      [elevation >= 1900] { marker: { elements: [ Dot { size: 7 px, color: #b8322a } ] }; }
   }
}
