{
  "stylingRules": [
    {
      "$comment": "/req/hill-shading/sun: the direction of the sun",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Elevation"
        ]
      },
      "symbolizer": {
        "singleChannel": {
          "property": "elevation"
        },
        "colorMap": [
          [
            0.0,
            "#efece4"
          ],
          [
            2500.0,
            "#efece4"
          ]
        ],
        "hillShading": {
          "factor": 1,
          "sun": {
            "azimuth": 315.0,
            "elevation": 45.0
          }
        }
      }
    }
  ]
}
