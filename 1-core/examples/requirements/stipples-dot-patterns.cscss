// /req/stipples/ratio, /req/dot-patterns/dotpattern, /req/dot-patterns/distance: stipple and dot pattern fills on the forest
Landcover
{
   marker: null;
   visibility: false;
   [class = 'forest']
   {
      visibility: true;
      fill: { color: #5e8f52; stipple: { ratio: 0.2 } };
      stroke: { color: #5e8f52; width: 0.5 px };
   }
}
