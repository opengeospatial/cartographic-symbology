// /req/dot-patterns/dotpattern: a dot pattern fill on the forest
Landcover
{
   marker: null;
   visibility: false;
   [class = 'forest']
   {
      visibility: true;
      fill: { color: #5e8f52; dotpattern: { distance: { horizontal: 6 px; vertical: 6 px } } };
      stroke: { color: #5e8f52; width: 0.5 px };
   }
}
