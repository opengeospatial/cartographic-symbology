{
  "stylingRules": [
    {
      "$comment": "/req/casing/center: center lines on top of the main strokes, not cut by joining roads",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Roads"
        ]
      },
      "symbolizer": {
        "visibility": false,
        "marker": null
      },
      "nestedRules": [
        {
          "selector": {
            "op": "and",
            "args": [
              {
                "op": "<>",
                "args": [
                  {
                    "property": "class"
                  },
                  "path"
                ]
              },
              {
                "op": "<>",
                "args": [
                  {
                    "property": "class"
                  },
                  "tractor"
                ]
              }
            ]
          },
          "symbolizer": {
            "visibility": true,
            "stroke": {
              "color": [
                243,
                227,
                181
              ],
              "width": {
                "px": 5.0
              },
              "casing": {
                "color": [
                  140,
                  129,
                  114
                ],
                "width": {
                  "px": 1.0
                }
              },
              "center": {
                "color": [
                  208,
                  72,
                  58
                ],
                "width": {
                  "px": 1.0
                }
              }
            }
          }
        }
      ]
    }
  ]
}
