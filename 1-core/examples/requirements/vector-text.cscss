// /req/vector/text, /req/vector/fonts: the alignment of a Text graphic relative to its position (the Dot)
Places
{
   visibility: false;
   marker: null;
   [type = 'mountain']
   {
      visibility: true;
      marker: { elements: [
         Dot { size: 4 px, color: #b8322a },
         Text { text: name, alignment: center middle,
                font: { face: 'Arial', size: 9, color: #2b2b2b } }
      ] };
   }
}
