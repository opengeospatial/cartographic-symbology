// /req/vector/marker, /req/vector/dot, /req/vector/graphics: the same marker at points, line vertices and polygon centroids
Huts
{
   marker: { elements: [ Dot { size: 7 px, color: white }, Dot { size: 4.5 px, color: #b8322a } ] };
}
Landcover
{
   visibility: false;
   [class = 'lake' and area > 20000]
   {
      visibility: true;
      fill: { color: #e2edf4 };
      stroke: { width: 0 };
      marker: { elements: [ Dot { size: 7 px, color: white }, Dot { size: 4.5 px, color: #b8322a } ] };
   }
}
Roads
{
   visibility: false;
   [class = 'path' and marked = true]
   {
      visibility: true;
      stroke: { color: #b8442f; width: 1 px };
      marker: { elements: [ Dot { size: 7 px, color: white }, Dot { size: 4.5 px, color: #b8322a } ] };
   }
}
