// /req/core/z-order: the rivers are drawn under or over the roads, by their zOrder
Roads
{
   marker: null;
   zOrder: 1;
   stroke: { color: #f2b84b; width: 5 px };
   [class = 'path' or class = 'tractor'] { visibility: false; }
}
Rivers
{
   marker: null;
   zOrder: 2;
   stroke: { color: #3f7fb3; width: 2 px };
}
