{
  "stylingRules": [
    {
      "$comment": "/req/core/selector: the second rule applies only to the land cover its selector selects",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Landcover"
        ]
      },
      "symbolizer": {
        "fill": {
          "color": [
            236,
            233,
            224
          ]
        },
        "stroke": {
          "color": [
            201,
            196,
            184
          ],
          "width": {
            "px": 0.5
          }
        },
        "marker": null
      }
    },
    {
      "selector": {
        "op": "and",
        "args": [
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.id"
              },
              "Landcover"
            ]
          },
          {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "forest"
            ]
          }
        ]
      },
      "symbolizer": {
        "fill": {
          "alter": true,
          "color": [
            94,
            143,
            82
          ]
        }
      }
    }
  ]
}
