// /req/right-hand/operands: the peaks higher than an expression on the right-hand side
Places
{
   visibility: false;
   marker: null;
   [type = 'mountain']
   {
      visibility: true;
      marker: { elements: [ Dot { size: 4 px, color: #9a958b } ] };
      [elevation > 1500 + 300] { marker: { elements: [ Dot { size: 7 px, color: #b8322a } ] }; }
   }
}
