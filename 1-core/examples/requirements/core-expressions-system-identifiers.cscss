// /req/core/expressions-system-identifiers: a hatch fill where the renderer supports hatches, a plain fill otherwise
Landcover
{
   marker: null;
   visibility: false;
   [class = 'forest']
   {
      visibility: true;
      fill: { color: #93bf85 };
      stroke: { color: #5e8f52; width: 0.5 px };
      [capabilities.hatches = true] { fill: { color: #5e8f52; hatch: { width: 1 px; angle: 45; distance: 6 px } }; }
   }
}
