.title 'Styling a land cover layer'
.description 'This is a simple example of how to style a land cover layer using Style & Symbology Core.'

Landcover[dataLayer.type = vector]
{
   visibility: false;

   [viz.sd < 200000 and viz.date > DATE('2020-01-01')]
   {
      visibility: true;
      opacity: 0.5;
      zOrder: 1;
   }
}
