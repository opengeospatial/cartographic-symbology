.title 'Roads and railway with casings and a feature pass'
.abstract 'Roads and the railway around Otta with built-in casings, ordered by z_order '
          '(0 in a tunnel, 1 on the ground, 2 on a bridge). Railway bridges get a wider white line '
          'with a dark casing in feature pass -1, drawn before the railway itself in pass 0.'

Transport
{
   visibility: false;
   marker: null;
   zOrder: z_order;

   [class = 'municipal' or class = 'private']  { visibility: true; stroke: { color: #ffffff; width: 2.5 px; casing: { color: #a69269; width: 0.75 px } }; }
   [class = 'county']                          { visibility: true; stroke: { color: #ff9999; width: 4 px;   casing: { color: #ff0000; width: 0.5 px } }; }
   [class = 'european' or class = 'national']  { visibility: true; stroke: { color: #ff6666; width: 6 px;   casing: { color: #990000; width: 1 px } }; }
   [class = 'railway']                         { visibility: true; stroke: { color: #ffffff; width: 1.5 px; dashPattern: [ 5 px, 5 px ]; casing: { color: #333333; width: 0.75 px } }; }

   // After the railway rule, so that it overrides the railway's stroke in pass -1
   [feature.pass = -1 and class = 'railway' and bridge = true]
   {
      stroke: { color: #ffffff; width: 6 px; casing: { color: #333333; width: 1 px } };
   }
}
