.title 'Styling line vector features'
.abstract 'Basic vector features styling (lines): roads in Sel, Norway (N50 Kartdata), colored by road class'

Roads[dataLayer.type = vector and dataLayer.featuresGeometryDimensions = 1]
{
   visibility: false;
   // No default Dot at each vertex
   marker: null;

   [viz.sd < 200000 and class <> 'path' and validDate >= viz.timeInterval.start.date and validDate <= viz.timeInterval.end.date]
   {
      visibility: true;
      zOrder: 2;
      // Private and tractor roads
      stroke: {color: #8c8172; width: 1.0 px; opacity: 1.0};

      // Select stroke color, width and drawing order based on the class property
      [class = 'municipal']
      {
         stroke: {color: #f2b84b; width: 2.5 px};
         zOrder: 3;
      }
      [class = 'county']
      {
         stroke: {color: #f2b84b; width: 3.5 px};
         zOrder: 4;
      }
      [class = 'national']
      {
         stroke: {color: #e8833a; width: 4.5 px};
         zOrder: 5;
      }
      [class = 'european']
      {
         stroke: {color: #d0483a; width: 5.5 px};
         zOrder: 6;
      }

      // If zoomed in more than 1:10,000
      [viz.sd < 10000]
      {
         // Change stroke width to 8 meters (12 meters for the main roads)
         stroke.width: 8.0 m;
         // Add Dot at each segment end-point
         marker: { elements: [
            Dot {
               size: 4 m; // Alias for base Shape class stroke width
               color: white;
            }
         ] };
         [class = 'national' or class = 'european']
         {
            stroke.width: 12.0 m;
         }
      }
   }
}
