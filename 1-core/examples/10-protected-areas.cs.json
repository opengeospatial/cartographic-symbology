{
  "metadata": {
    "title": "Protected areas by class",
    "abstract": "This style is used to draw the protected areas around Rondane, Norway, colored by the kind of protection.\n This style uses the protected areas of N50 Kartdata from the Norwegian Mapping Authority (Kartverket), available at https://kartkatalog.geonorge.no/metadata/n50-kartdata/ea192681-d039-42ec-b1bc-f3ce04c189ac",
    "keywords": [
      "Protected area",
      "National park",
      "Norway"
    ]
  },
  "stylingRules": [
    {
      "selector": {
        "op": "and",
        "args": [
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.id"
              },
              "ProtectedAreas"
            ]
          },
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.type"
              },
              "vector"
            ]
          }
        ]
      },
      "symbolizer": {
        "visibility": true,
        "zOrder": 1,
        "stroke": {
          "color": [
            93,
            107,
            85
          ],
          "opacity": 1.0,
          "width": {
            "px": 1.0
          }
        },
        "marker": null,
        "label": {
          "elements": [
            {
              "type": "Text",
              "text": {
                "property": "name"
              },
              "alignment": [
                "center",
                "middle"
              ],
              "font": {
                "face": "Arial",
                "size": 8,
                "color": [
                  43,
                  43,
                  43
                ]
              }
            }
          ]
        }
      },
      "nestedRules": [
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "nationalPark"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                169,
                207,
                152
              ]
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "landscapeProtection"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                227,
                212,
                142
              ]
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "natureReserve"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                235,
                165,
                127
              ]
            }
          }
        }
      ]
    }
  ]
}
