.title 'Styling point vector features'
.abstract 'Basic vector features styling (points): tourist cabins in Dørålen, Rondane, Norway (N50 Kartdata)'

Huts[dataLayer.type = 'vector' and dataLayer.featuresGeometryDimensions = 0]
{
   visibility: false;

   [viz.sd < 200000 and validDate >= viz.timeInterval.start.date and validDate <= viz.timeInterval.end.date]
   {
      visibility: true;
      opacity: 0.9;
      zOrder: 3;
      // A small Dot (positioned at the point)
      marker: { elements: [ Dot { size: 7 px; color: #b8322a } ] };

      // If zoomed in more than 1:10,000
      [viz.sd < 10000]
      {
         // Replace it with a double-Dot marker (positioned at centroid)
         marker: { elements: [
            Dot {  // larger white dot underneath
               size: 14 px; // Alias for base Shape class stroke width
               position: 0 0;
               color: white;
            },
            Dot {  // smaller red dot in center
               size: 10 px; // Alias for base Shape class stroke width
               position: 0 0;
               color: #b8322a;
            }
         ]};
         [viz.sd < 5000]
         {
            // Add a Text graphic to Marker at 1:5000
            marker.elements[2]:
               Text {
                  position: 12 0; // Offset 12 pixels to the right
                  text: name; // Name of the cabin
                  alignment: left middle;
                  font: {
                     face: 'Arial';
                     size: 12 pt;
                     bold: true;
                     italic: false;
                     opacity: 1.0;
                     color: #2b2b2b;
                  }
               };
         }
      }
   }
}
