          "symbolizer": {
            "visibility": true,
            "fill": {
              "color": [
                183,
                211,
                230
              ]
            },
            "stroke": {
              "color": [
                63,
                127,
                179
              ],
              "width": {
                "px": 1.0
              }
            }
          }
        }
      ]
    }
  ]
}
