{
  "stylingRules": [
    {
      "$comment": "/req/core/rules, selector, nested, symbolizer, visibility, layers, expressions-field-identifiers",
      "selector": {
        "op": "and",
        "args": [
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.id"
              },
              "Landcover"
            ]
          },
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.type"
              },
              "vector"
            ]
          }
        ]
      },
      "symbolizer": {
        "fill": {
          "color": [
            228,
            224,
            212
          ]
        },
        "stroke": {
          "color": [
            184,
            178,
            162
          ],
          "width": {
            "px": 0.75
          }
        },
        "marker": null
      },
      "nestedRules": [
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "forest"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                147,
                191,
                133
              ]
            }
          },
          "nestedRules": [
            {
              "$comment": "Nested twice: small forest patches",
              "selector": {
                "op": "<",
                "args": [
                  {
                    "property": "area"
                  },
                  50000
                ]
              },
              "symbolizer": {
                "fill": {
                  "alter": true,
                  "color": [
                    201,
                    224,
                    187
                  ]
                }
              }
            }
          ]
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "bog"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                227,
                220,
                176
              ]
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "farmland"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                243,
                231,
                184
              ]
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "lake"
            ]
          },
          "symbolizer": {
            "fill": {
              "alter": true,
              "color": [
                183,
                211,
                230
              ]
            },
            "stroke": {
              "color": [
                63,
                127,
                179
              ],
              "width": {
                "px": 1.5
              }
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "property": "class"
              },
              "open"
            ]
          },
          "symbolizer": {
            "visibility": false
          }
        }
      ]
    }
  ]
}
