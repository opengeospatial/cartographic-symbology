{
  "stylingRules": [
    {
      "$comment": "/req/vector/marker, /req/vector/dot, /req/vector/graphics: markers at points, line vertices and polygon centroids",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Huts"
        ]
      },
      "symbolizer": {
        "marker": {
          "elements": [
            {
              "type": "Dot",
              "size": {
                "px": 14
              },
              "color": "white"
            },
            {
              "type": "Dot",
              "size": {
                "px": 9
              },
              "color": [
                184,
                50,
                42
              ]
            },
            {
              "type": "Dot",
              "size": {
                "px": 5
              },
              "color": [
                184,
                50,
                42
              ],
              "position": {
                "x": 12.0,
                "y": 12.0
              }
            }
          ]
        }
      }
    },
    {
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Landcover"
        ]
      },
      "symbolizer": {
        "visibility": false
      },
      "nestedRules": [
        {
          "selector": {
            "op": "and",
            "args": [
              {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "lake"
                ]
              },
              {
                "op": ">",
                "args": [
                  {
                    "property": "area"
                  },
                  20000
                ]
              }
            ]
          },
          "symbolizer": {
            "visibility": true,
            "fill": {
              "color": [
                207,
                225,
                238
              ]
            },
            "stroke": {
              "width": 0.0
            },
            "marker": {
              "elements": [
                {
                  "type": "Dot",
                  "size": {
                    "px": 7
                  },
                  "color": "white"
                },
                {
                  "type": "Dot",
                  "size": {
                    "px": 5
                  },
                  "color": [
                    31,
                    78,
                    121
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Roads"
        ]
      },
      "symbolizer": {
        "visibility": false
      },
      "nestedRules": [
        {
          "selector": {
            "op": "and",
            "args": [
              {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "path"
                ]
              },
              {
                "op": "=",
                "args": [
                  {
                    "property": "marked"
                  },
                  true
                ]
              }
            ]
          },
          "symbolizer": {
            "visibility": true,
            "stroke": {
              "color": [
                184,
                68,
                47
              ],
              "width": {
                "px": 1.0
              }
            },
            "marker": {
              "elements": [
                {
                  "type": "Dot",
                  "size": {
                    "px": 3
                  },
                  "color": [
                    184,
                    68,
                    47
                  ]
                }
              ]
            }
          }
        }
      ]
    }
