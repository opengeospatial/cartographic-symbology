{
  "metadata": {
    "title": "Styling point vector features",
    "abstract": "Basic vector features styling (points): tourist cabins in Dørålen, Rondane, Norway (N50 Kartdata)"
  },
  "stylingRules": [
    {
      "selector": {
        "op": "and",
        "args": [
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.id"
              },
              "Huts"
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "=",
                "args": [
                  {
                    "sysId": "dataLayer.type"
                  },
                  "vector"
                ]
              },
              {
                "op": "=",
                "args": [
                  {
                    "sysId": "dataLayer.featuresGeometryDimensions"
                  },
                  0
                ]
              }
            ]
          }
        ]
      },
      "symbolizer": {
        "visibility": false
      },
      "nestedRules": [
        {
          "selector": {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "<",
                    "args": [
                      {
                        "sysId": "viz.sd"
                      },
                      200000
                    ]
                  },
                  {
                    "op": ">=",
                    "args": [
                      {
                        "property": "validDate"
                      },
                      {
                        "sysId": "viz.timeInterval.start.date"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "<=",
                "args": [
                  {
                    "property": "validDate"
                  },
                  {
                    "sysId": "viz.timeInterval.end.date"
                  }
                ]
              }
            ]
          },
          "symbolizer": {
            "$comment": "A small Dot (positioned at the point)",
            "visibility": true,
            "opacity": 0.9,
            "zOrder": 3,
            "marker": {
              "elements": [
                {
                  "type": "Dot",
                  "size": {
                    "px": 7
                  },
                  "color": [
                    184,
                    50,
                    42
                  ]
                }
              ]
            }
          },
          "nestedRules": [
            {
              "$comment": "If zoomed in more than 1:10,000",
              "selector": {
                "op": "<",
                "args": [
                  {
                    "sysId": "viz.sd"
                  },
                  10000
                ]
              },
              "symbolizer": {
                "$comment": "Replace it with a double-Dot marker (positioned at centroid)",
                "marker": {
                  "elements": [
                    {
                      "type": "Dot",
                      "size": {
                        "px": 14
                      },
                      "position": {
                        "x": 0.0,
                        "y": 0.0
                      },
                      "color": "white"
                    },
                    {
                      "type": "Dot",
                      "size": {
                        "px": 10
                      },
                      "position": {
                        "x": 0.0,
                        "y": 0.0
                      },
                      "color": [
                        184,
                        50,
                        42
                      ]
                    }
                  ]
                }
              },
              "nestedRules": [
                {
                  "selector": {
                    "op": "<",
                    "args": [
                      {
                        "sysId": "viz.sd"
                      },
                      5000
                    ]
                  },
                  "symbolizer": {
                    "$comment": "Add a Text graphic to Marker at 1:5000",
                    "marker": {
                      "alter": true,
                      "elements": {
                        "index": 2,
                        "value": {
                          "type": "Text",
                          "position": {
                            "x": 12.0,
                            "y": 0.0
                          },
                          "text": {
                            "property": "name"
                          },
                          "alignment": [
                            "left",
                            "middle"
                          ],
                          "font": {
                            "face": "Arial",
                            "size": {
                              "pt": 12
                            },
                            "bold": true,
                            "italic": false,
                            "opacity": 1.0,
                            "color": [
                              43,
                              43,
                              43
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
