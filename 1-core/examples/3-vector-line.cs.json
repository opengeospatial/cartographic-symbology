{
  "metadata": {
    "title": "Styling line vector features",
    "description": "Basic vector features styling (lines): roads in Sel, Norway (N50 Kartdata), colored by road class"
  },
  "stylingRules": [
    {
      "selector": {
        "op": "and",
        "args": [
          {
            "op": "=",
            "args": [
              {
                "sysId": "dataLayer.id"
              },
              "Roads"
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "=",
                "args": [
                  {
                    "sysId": "dataLayer.type"
                  },
                  "vector"
                ]
              },
              {
                "op": "=",
                "args": [
                  {
                    "sysId": "dataLayer.featuresGeometryDimensions"
                  },
                  1
                ]
              }
            ]
          }
        ]
      },
      "symbolizer": {
        "$comment": "No default Dot at each vertex",
        "visibility": false,
        "marker": null
      },
      "nestedRules": [
        {
          "selector": {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "<",
                        "args": [
                          {
                            "sysId": "viz.sd"
                          },
                          200000
                        ]
                      },
                      {
                        "op": "<>",
                        "args": [
                          {
                            "property": "class"
                          },
                          "path"
                        ]
                      }
                    ]
                  },
                  {
                    "op": ">=",
                    "args": [
                      {
                        "property": "validDate"
                      },
                      {
                        "sysId": "viz.timeInterval.start.date"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "<=",
                "args": [
                  {
                    "property": "validDate"
                  },
                  {
                    "sysId": "viz.timeInterval.end.date"
                  }
                ]
              }
            ]
          },
          "symbolizer": {
            "$comment": "Private and tractor roads",
            "visibility": true,
            "zOrder": 2,
            "stroke": {
              "color": [
                140,
                129,
                114
              ],
              "opacity": 1.0,
              "width": {
                "px": 1.0
              }
            }
          },
          "nestedRules": [
            {
              "$comment": "Select stroke color, width and drawing order based on the class property",
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "municipal"
                ]
              },
              "symbolizer": {
                "zOrder": 3,
                "stroke": {
                  "color": [
                    242,
                    184,
                    75
                  ],
                  "width": {
                    "px": 2.5
                  }
                }
              }
            },
            {
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "county"
                ]
              },
              "symbolizer": {
                "zOrder": 4,
                "stroke": {
                  "color": [
                    242,
                    184,
                    75
                  ],
                  "width": {
                    "px": 3.5
                  }
                }
              }
            },
            {
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "national"
                ]
              },
              "symbolizer": {
                "zOrder": 5,
                "stroke": {
                  "color": [
                    232,
                    131,
                    58
                  ],
                  "width": {
                    "px": 4.5
                  }
                }
              }
            },
            {
              "selector": {
                "op": "=",
                "args": [
                  {
                    "property": "class"
                  },
                  "european"
                ]
              },
              "symbolizer": {
                "zOrder": 6,
                "stroke": {
                  "color": [
                    208,
                    72,
                    58
                  ],
                  "width": {
                    "px": 5.5
                  }
                }
              }
            },
            {
              "$comment": "If zoomed in more than 1:10,000",
              "selector": {
                "op": "<",
                "args": [
                  {
                    "sysId": "viz.sd"
                  },
                  10000
                ]
              },
              "symbolizer": {
                "$comment": "Change stroke width to 8 meters (12 meters for the main roads)\nAdd Dot at each segment end-point",
                "stroke": {
                  "alter": true,
                  "width": {
                    "m": 8.0
                  }
                },
                "marker": {
                  "elements": [
                    {
                      "type": "Dot",
                      "size": {
                        "m": 4
                      },
                      "color": "white"
                    }
                  ]
                }
              },
              "nestedRules": [
                {
                  "selector": {
                    "op": "or",
                    "args": [
                      {
                        "op": "=",
                        "args": [
                          {
                            "property": "class"
                          },
                          "national"
                        ]
                      },
                      {
                        "op": "=",
                        "args": [
                          {
                            "property": "class"
                          },
                          "european"
                        ]
                      }
                    ]
                  },
                  "symbolizer": {
                    "stroke": {
                      "alter": true,
                      "width": {
                        "m": 12.0
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
